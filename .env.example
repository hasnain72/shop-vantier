APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_shop
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── MyFatoorah (Kuwait / MENA payment gateway) ─────────────────
# Get a sandbox API key from https://portal.myfatoorah.com. Do NOT commit real keys.
MYFATOORAH_ENV=sandbox
# Leave BASE_URL blank to auto-pick by env (sandbox=apitest, live=api). Only set to force a specific host.
MYFATOORAH_BASE_URL=
MYFATOORAH_API_KEY=
# Optional server-to-server webhook secret. If set, MF must send it in `MyFatoorah-Signature` header.
MYFATOORAH_WEBHOOK_SECRET=
# Angular storefront URLs the customer is bounced back to after paying / failing.
MYFATOORAH_RETURN_URL=http://localhost:4200/checkout/success
MYFATOORAH_ERROR_URL=http://localhost:4200/checkout/failed
# Charge/display currency. MF supports: KWD, SAR, AED, USD, EUR, GBP, BHD, QAR, OMR, JOD.
MYFATOORAH_CURRENCY=KWD

# ── SMSA Express (Saudi shipping courier) ──────────────────────
# Get your PassKey + Account No. from your SMSA sales rep. Sandbox by default.
SMSA_ENV=sandbox
SMSA_BASE_URL=https://track.smsaexpress.com/api
SMSA_PASSKEY=
SMSA_ACCOUNT_NO=
SMSA_WEBHOOK_SECRET=
# Default sender / pickup details (used when a location doesn't override them).
SMSA_SENDER_NAME="Vantier Store"
SMSA_SENDER_CONTACT="Store Manager"
SMSA_SENDER_PHONE=
SMSA_SENDER_EMAIL=
SMSA_SENDER_CITY=Riyadh
SMSA_SENDER_COUNTRY=SA
SMSA_CURRENCY=SAR
# Service codes vary by contract: PDO (Prepaid), CCO (Cash on Delivery), etc.
SMSA_SERVICE_CODE=PDO
