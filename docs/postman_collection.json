{
  "info": {
    "name": "Vantier Shop API v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Complete REST API for Vantier Laravel e-commerce store."
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api/v1" },
    { "key": "token",    "value": "" },
    { "key": "cart_token","value": "" }
  ],
  "item": [
    {
      "name": "Shop",
      "item": [
        { "name": "Health Check",  "request": { "method": "GET",  "url": "{{base_url}}/health" } },
        { "name": "Shop Info",     "request": { "method": "GET",  "url": "{{base_url}}/shop" } }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST", "url": "{{base_url}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"first_name\": \"Ali\",\n  \"last_name\": \"Hassan\",\n  \"email\": \"ali@example.com\",\n  \"password\": \"password\",\n  \"password_confirmation\": \"password\"\n}" }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST", "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"ahmed.khan@example.com\",\n  \"password\": \"password\"\n}" }
          }
        },
        { "name": "Logout",         "request": { "method": "POST", "url": "{{base_url}}/auth/logout", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "Me",             "request": { "method": "GET",  "url": "{{base_url}}/auth/me",    "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST", "url": "{{base_url}}/auth/forgot-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"ahmed.khan@example.com\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        { "name": "List Products",        "request": { "method": "GET", "url": "{{base_url}}/products?page=1&limit=20" } },
        { "name": "Product Count",        "request": { "method": "GET", "url": "{{base_url}}/products/count" } },
        { "name": "Get Product by ID",    "request": { "method": "GET", "url": "{{base_url}}/products/1" } },
        { "name": "Get Product by Handle","request": { "method": "GET", "url": "{{base_url}}/products/handle/classic-leather-watch" } },
        { "name": "Filter by Collection", "request": { "method": "GET", "url": "{{base_url}}/products?collection_id=1" } },
        { "name": "Filter by Vendor",     "request": { "method": "GET", "url": "{{base_url}}/products?vendor=Meridian+Watches" } }
      ]
    },
    {
      "name": "Collections",
      "item": [
        { "name": "List Collections",        "request": { "method": "GET", "url": "{{base_url}}/collections" } },
        { "name": "Collections Count",       "request": { "method": "GET", "url": "{{base_url}}/collections/count" } },
        { "name": "Get Collection by ID",    "request": { "method": "GET", "url": "{{base_url}}/collections/1" } },
        { "name": "Get Collection by Handle","request": { "method": "GET", "url": "{{base_url}}/collections/handle/best-sellers" } },
        { "name": "Collection Products",     "request": { "method": "GET", "url": "{{base_url}}/collections/1/products" } }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Add to Cart",
          "request": {
            "method": "POST", "url": "{{base_url}}/cart/add",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"items\": [\n    { \"variant_id\": 1, \"quantity\": 2 }\n  ]\n}" }
          }
        },
        { "name": "Get Cart",  "request": { "method": "GET",  "url": "{{base_url}}/cart", "header": [{ "key": "X-Cart-Token", "value": "{{cart_token}}" }] } },
        {
          "name": "Update Cart",
          "request": {
            "method": "POST", "url": "{{base_url}}/cart/update",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Cart-Token", "value": "{{cart_token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"updates\": { \"1\": 3 }\n}" }
          }
        },
        {
          "name": "Apply Discount",
          "request": {
            "method": "POST", "url": "{{base_url}}/cart/apply-discount",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"discount_code\": \"SUMMER20\"\n}" }
          }
        },
        { "name": "Shipping Rates", "request": { "method": "GET", "url": "{{base_url}}/cart/shipping-rates?country_code=PK" } },
        { "name": "Clear Cart",     "request": { "method": "POST","url": "{{base_url}}/cart/clear", "header": [{ "key": "X-Cart-Token", "value": "{{cart_token}}" }] } }
      ]
    },
    {
      "name": "Checkout & Orders",
      "item": [
        {
          "name": "Validate Checkout",
          "request": {
            "method": "POST", "url": "{{base_url}}/checkout/validate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"cart_token\": \"{{cart_token}}\",\n  \"shipping_address\": { \"country_code\": \"PK\" },\n  \"discount_code\": \"SUMMER20\"\n}" }
          }
        },
        {
          "name": "Create Order",
          "request": {
            "method": "POST", "url": "{{base_url}}/orders",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"customer@example.com\",\n  \"line_items\": [\n    { \"variant_id\": 1, \"quantity\": 1 }\n  ],\n  \"shipping_address\": {\n    \"first_name\": \"Ahmed\",\n    \"last_name\": \"Khan\",\n    \"address1\": \"Street 1\",\n    \"city\": \"Karachi\",\n    \"country\": \"Pakistan\",\n    \"country_code\": \"PK\"\n  },\n  \"gateway\": \"cod\"\n}" }
          }
        },
        { "name": "Get Order",    "request": { "method": "GET",  "url": "{{base_url}}/orders/1", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        {
          "name": "Cancel Order",
          "request": {
            "method": "POST", "url": "{{base_url}}/orders/1/cancel",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"customer\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Discounts",
      "item": [
        {
          "name": "Lookup Discount Code",
          "request": {
            "method": "POST", "url": "{{base_url}}/discount_codes/lookup",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"SUMMER20\",\n  \"line_items\": [\n    { \"variant_id\": 1, \"quantity\": 1 }\n  ]\n}" }
          }
        }
      ]
    },
    {
      "name": "Shipping",
      "item": [
        { "name": "Get Shipping Rates", "request": { "method": "GET",  "url": "{{base_url}}/shipping/rates?shipping_address[country_code]=PK&line_items[0][variant_id]=1&line_items[0][quantity]=1" } },
        {
          "name": "Estimate Shipping",
          "request": {
            "method": "POST", "url": "{{base_url}}/shipping/estimate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"shipping_address\": { \"country_code\": \"US\", \"province_code\": \"CA\" },\n  \"line_items\": [\n    { \"variant_id\": 1, \"quantity\": 1 }\n  ]\n}" }
          }
        }
      ]
    },
    {
      "name": "Customer Account",
      "item": [
        { "name": "My Profile",     "request": { "method": "GET", "url": "{{base_url}}/customers/me", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "My Orders",      "request": { "method": "GET", "url": "{{base_url}}/customers/me/orders", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        { "name": "My Addresses",   "request": { "method": "GET", "url": "{{base_url}}/customers/me/addresses", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } },
        {
          "name": "Add Address",
          "request": {
            "method": "POST", "url": "{{base_url}}/customers/me/addresses",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"first_name\": \"Ahmed\",\n  \"last_name\": \"Khan\",\n  \"address1\": \"Street 1\",\n  \"city\": \"Karachi\",\n  \"country\": \"Pakistan\",\n  \"country_code\": \"PK\",\n  \"zip\": \"75300\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Search",
      "item": [
        { "name": "Search All",      "request": { "method": "GET", "url": "{{base_url}}/search?q=watch" } },
        { "name": "Search Products", "request": { "method": "GET", "url": "{{base_url}}/search?q=leather&type=product" } }
      ]
    },
    {
      "name": "CMS",
      "item": [
        { "name": "List Pages",        "request": { "method": "GET", "url": "{{base_url}}/pages" } },
        { "name": "Get Page",          "request": { "method": "GET", "url": "{{base_url}}/pages/about-us" } },
        { "name": "List Blogs",        "request": { "method": "GET", "url": "{{base_url}}/blogs" } },
        { "name": "Blog Articles",     "request": { "method": "GET", "url": "{{base_url}}/blogs/news/articles" } },
        { "name": "Get Article",       "request": { "method": "GET", "url": "{{base_url}}/articles/1" } }
      ]
    }
  ]
}
